# MongoDB Atlas Connection String (never commit real credentials)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medwatch

# JWT Signing Secret (minimum 32 random hex characters)
JWT_SECRET=replace_with_a_strong_64_char_secret

# Server Port and Allowed Frontend Origins
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SMTP Email Service (Required for Email Verification & Password Reset links)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="MedWatch AI <no-reply@example.com>"

# Optional: comma-separated DNS servers for SRV resolution override
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
